NODE_ENV=development

DATABASE_URL=postgresql://fair_platform:fair_platform@localhost:5433/fair_platform
REDIS_URL=redis://localhost:6379

PASARGUARD_BASE_URL=https://example.com

APP_ENCRYPTION_KEY=
SESSION_SECRET=

# FP-001: encryption key must be 64 hexadecimal characters (32 random bytes).
PASARGUARD_SOURCE_INSTANCE_ID=primary
RAW_WEBHOOK_RETENTION_DAYS=14
WEBHOOK_NORMALIZATION_MAX_ATTEMPTS=5
WEBHOOK_WORKER_POLL_INTERVAL_MS=1000
# Explicit local/test bypass only. Production fails closed pending verified auth.
PASARGUARD_ALLOW_UNAUTHENTICATED_DEVELOPMENT=false
