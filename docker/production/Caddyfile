{
	email {$ACME_EMAIL}
	auto_https disable_redirects
	admin off
	servers {
		protocols h1 h2
		timeouts {
			read_body 10s
			read_header 10s
			write 30s
			idle 2m
		}
	}
}
{$OWNER_HOST} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Cache-Control no-store
		-Server
	}
	@webhook path /api/v1/owner/webhook/pasarguard
	handle @webhook {
		request_body {
			max_size 256KB
		}
		reverse_proxy owner-api:3001 {
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			transport http {
				dial_timeout 5s
				response_header_timeout 10s
			}
		}
	}
	@owner path /api/v1/owner/* /health/live /health/ready
	handle @owner {
		request_body {
			max_size 4KB
		}
		reverse_proxy owner-api:3001 {
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			transport http {
				dial_timeout 5s
				response_header_timeout 10s
			}
		}
	}
	handle {
		request_body {
			max_size 4KB
		}
		reverse_proxy web:3000
	}
}
