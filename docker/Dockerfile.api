FROM node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /src
RUN npm install --global pnpm@12.6.0
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @fair-platform/pasarguard --filter @fair-platform/api build
RUN pnpm --filter @fair-platform/api deploy --legacy --prod /out

FROM node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out ./
COPY --chown=node:node docker/staging/api-entrypoint.sh /app/entrypoint.sh
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /opt/yarn* /usr/local/bin/yarn*
USER node
HEALTHCHECK --interval=15s --timeout=6s --start-period=20s --retries=5 CMD node -e "fetch('http://127.0.0.1:3001/health/ready',{signal:AbortSignal.timeout(5000)}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["sh", "/app/entrypoint.sh"]
CMD ["node", "dist/owner/main.js"]
