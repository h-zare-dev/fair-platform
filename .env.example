NODE_ENV=development

DATABASE_URL=postgresql://fair_platform:fair_platform@localhost:5433/fair_platform
REDIS_URL=redis://localhost:6379

PASARGUARD_BASE_URL=https://example.com

APP_ENCRYPTION_KEY=
SESSION_SECRET=

# FP-001: encryption key must be 64 hexadecimal characters (32 random bytes).
PASARGUARD_SOURCE_INSTANCE_ID=primary
RAW_WEBHOOK_RETENTION_DAYS=14
WEBHOOK_NORMALIZATION_MAX_ATTEMPTS=5
WEBHOOK_WORKER_POLL_INTERVAL_MS=1000
# Explicit local/test bypass only. Production fails closed pending verified auth.
PASARGUARD_ALLOW_UNAUTHENTICATED_DEVELOPMENT=false

# Owner-only, non-posting FP-006/007 preview; bounded source-time Reset/Update window.
FAIR_CORRELATION_WINDOW_SECONDS=600

# Owner-approved replay-only SHADOW accounting. Never debits PasarGuard balances.
# false (default): Delete is non-financial. true: credit the last verified purchase
# in the historical SHADOW ledger, even if Delete happens on a later day.
# Changing it applies only to NEW replay runs; old journal entries are immutable.
FAIR_SHADOW_DELETE_CREDIT_ENABLED=false
