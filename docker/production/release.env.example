# Copy to /etc/fair-production/release.env (mode 0600) after Owner review.
# Replace each placeholder with a reviewed, published GHCR @sha256 digest.
# Never use :latest or unreviewed mutable tags.
RELEASE_SHA=REPLACE_WITH_40_HEX_REVIEWED_DEVELOPMENT_COMMIT
API_IMAGE=ghcr.io/h-zare-dev/fair-platform-owner-api@sha256:REPLACE_WITH_64_HEX_DIGEST
WEB_IMAGE=ghcr.io/h-zare-dev/fair-platform-web@sha256:REPLACE_WITH_64_HEX_DIGEST
CADDY_IMAGE=ghcr.io/h-zare-dev/fair-platform-caddy@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_IMAGE=ghcr.io/h-zare-dev/fair-platform-postgres@sha256:REPLACE_WITH_64_HEX_DIGEST
SECRETS_DIR=/etc/fair-production/secrets
ACME_EMAIL=REPLACE_WITH_OWNER_EMAIL
FAIR_REPORT_CALENDAR=jalali
FAIR_REPORT_WEEK_START_DAY=SATURDAY
